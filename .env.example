# FixPilot Environment Variables

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
JWT_SECRET="super-secret-fixpilot-key-32-characters-minimum"

# Database (Prisma)
# SQLite for instant zero-dependency local dev: file:./dev.db
# PostgreSQL for production (e.g. Neon, Supabase, AWS RDS): postgresql://postgres:postgres@localhost:5432/fixpilot?schema=public
DATABASE_URL="file:./dev.db"

# Google Antigravity Agent Configuration
ANTIGRAVITY_API_KEY="test-antigravity-key"
ANTIGRAVITY_BASE_URL="https://api.antigravity.google.com/v1"
ANTIGRAVITY_MODEL="gemini-3.8-flash"
ANTIGRAVITY_EXECUTION_TIMEOUT=300
ANTIGRAVITY_MAX_TOKENS=16000

# Jira Integration
JIRA_HOST="https://your-company.atlassian.net"
JIRA_EMAIL="dev@fixpilot.io"
JIRA_API_TOKEN="mock-jira-token"
JIRA_WEBHOOK_SECRET="jira-secret-key-12345"

# GitHub Integration
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMOCK\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="gh-secret-token-12345"
GITHUB_CLIENT_ID="mock-gh-client-id"
GITHUB_CLIENT_SECRET="mock-gh-client-secret"

# Execution Constraints
WORKSPACE_BASE_DIR="./workspaces"
MAX_RETRY_COUNT=3
QA_TIMEOUT_SECONDS=180
